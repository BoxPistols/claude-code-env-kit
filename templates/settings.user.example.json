{
  "permissions": {
    "deny": [
      "Read(//**/.env)", "Read(//**/.env.local)", "Read(//**/.env.*.local)", "Read(//**/.env.production)",
      "Edit(//**/.env)", "Edit(//**/.env.local)", "Edit(//**/.env.*.local)", "Edit(//**/.env.production)",
      "Read(~/.ssh/**)", "Read(~/.aws/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "python3 \"$HOME/.claude/hooks/no-ai-signature.py\"" }]
      }
    ]
  }
}
