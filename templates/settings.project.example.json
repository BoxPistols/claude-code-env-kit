{
  "extraKnownMarketplaces": {
    "claude-code-env-kit": {
      "source": {
        "source": "github",
        "repo": "BoxPistols/claude-code-env-kit"
      }
    }
  },
  "enabledPlugins": {
    "env-kit@claude-code-env-kit": true
  },
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.production)"
    ]
  }
}
